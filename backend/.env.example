# SQLite is used by default; no separate database server required.
# For PostgreSQL, uncomment and edit DATABASE_URL:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/brandcheck
DATABASE_URL=sqlite:///./brandcheck.db
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=720

# Optional contextual tone/messaging review. Leave blank for offline deterministic checks.
# If configured, draft text and brand sources are sent to the chosen OpenAI-compatible API.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
